--------------------------------------------------------------------------------
-- DYNAMIC HOVER EFFECTS & ANIMATIONS
--------------------------------------------------------------------------------
local function applyToggleHover(btn, getStateFunc, greenColor, redColor, greenHover, redHover)
    btn.MouseEnter:Connect(function()
        local isEnabled = getStateFunc()
        local hoverCol = isEnabled and greenHover or redHover
        TweenService:Create(btn, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            BackgroundColor3 = hoverCol,
            Position = btn.Position - UDim2.new(0, 0, 0, 1)
        }):Play()
    end)
    btn.MouseLeave:Connect(function()
        local isEnabled = getStateFunc()
        local baseCol = isEnabled and greenColor or redColor
        TweenService:Create(btn, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            BackgroundColor3 = baseCol,
            Position = btn.Position + UDim2.new(0, 0, 0, 1)
        }):Play()
    end)
end

applyToggleHover(
    toggleBtn, 
    function() return autoBlockEnabled end, 
    Color3.fromRGB(46, 204, 113), 
    Color3.fromRGB(231, 76, 60), 
    Color3.fromRGB(66, 224, 133), 
    Color3.fromRGB(251, 96, 80)
)

applyToggleHover(
    subToggleBtn, 
    function() return autoSubmitEnabled end, 
    Color3.fromRGB(46, 204, 113), 
    Color3.fromRGB(231, 76, 60), 
    Color3.fromRGB(66, 224, 133), 
    Color3.fromRGB(251, 96, 80)
)

local function applyHoverEffect(btn, originalColor, hoverColor)
    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            BackgroundColor3 = hoverColor,
            Position = btn.Position - UDim2.new(0, 0, 0, 1)
        }):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            BackgroundColor3 = originalColor,
            Position = btn.Position + UDim2.new(0, 0, 0, 1)
        }):Play()
    end)
end

applyHoverEffect(beltBtn1, Color3.fromRGB(70, 70, 80), Color3.fromRGB(90, 90, 100))
applyHoverEffect(beltBtn2, Color3.fromRGB(70, 70, 80), Color3.fromRGB(90, 90, 100))

