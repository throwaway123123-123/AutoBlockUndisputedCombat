notifText.TextXAlignment = Enum.TextXAlignment.Left
notifText.Parent = notifFrame

local activeNotifThread = nil
local tweenInfoNotif = TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

local function showNotification()
    if activeNotifThread then
        task.cancel(activeNotifThread)
    end
    notifFrame.Visible = true
    TweenService:Create(notifFrame, tweenInfoNotif, {BackgroundTransparency = 0}):Play()
    TweenService:Create(notifHeader, tweenInfoNotif, {TextTransparency = 0}):Play()
    TweenService:Create(notifText, tweenInfoNotif, {TextTransparency = 0}):Play()
    
    activeNotifThread = task.delay(3.5, function()
        local fadeOutBg = TweenService:Create(notifFrame, tweenInfoNotif, {BackgroundTransparency = 1})
        TweenService:Create(notifHeader, tweenInfoNotif, {TextTransparency = 1}):Play()
        TweenService:Create(notifText, tweenInfoNotif, {TextTransparency = 1}):Play()
        fadeOutBg:Play()
        fadeOutBg.Completed:Wait()
        if notifFrame.BackgroundTransparency == 1 then notifFrame.Visible = false end
        activeNotifThread = nil
    end)
end

--------------------------------------------------------------------------------
-- STARTUP ANIMATION (LOADING -> MAIN MORPH)
--------------------------------------------------------------------------------
task.spawn(function()
    task.wait(3.5)
    
    local fadeOutInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    TweenService:Create(loadingTitle, fadeOutInfo, {TextTransparency = 1}):Play()
    TweenService:Create(loadingGear, fadeOutInfo, {ImageTransparency = 1}):Play()
    
    task.wait(0.3)
    gearTween:Cancel()
    
    local morphTween = TweenService:Create(loadingFrame, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 255, 0, 280)
    })
    morphTween:Play()
    morphTween.Completed:Wait()
    
    loadingFrame.Visible = false
    mainFrame.Visible = true
    TweenService:Create(uiScale, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1}):Play()
end)

--------------------------------------------------------------------------------
-- ANIMATIONS & KEYBINDS
--------------------------------------------------------------------------------
local function closeMenu()
    TweenService:Create(uiScale, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Scale = 0}):Play()
    task.delay(0.3, function() mainFrame.Visible = false end)
    showNotification()
end

local function openMenu()
    mainFrame.Visible = true
    TweenService:Create(uiScale, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1}):Play()
end

closeBtn.MouseButton1Click:Connect(closeMenu)

conns[#conns+1] = UIS.InputBegan:Connect(function(input, gameProcessed)
    if not gameProcessed and input.KeyCode == Enum.KeyCode.B then
        if loadingFrame.Visible then return end
        if mainFrame.Visible and uiScale.Scale > 0.5 then
            closeMenu()
        elseif not mainFrame.Visible or uiScale.Scale < 0.5 then
            openMenu()
        end
    end
end)

local dragging, dragInput, dragStart, startPos

local function startDrag(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = mainFrame.Position
        
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end

titleBar.InputBegan:Connect(startDrag)
loadingFrame.InputBegan:Connect(startDrag)

local function updateDrag(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end

titleBar.InputChanged:Connect(updateDrag)
loadingFrame.InputChanged:Connect(updateDrag)

UIS.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        local newPos = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
        mainFrame.Position = newPos
        loadingFrame.Position = newPos
    end
end)

local activeRatingTween = nil
local function updateRatingText(val)
    if activeRatingTween then
        activeRatingTween:Cancel()
    end

    local targetColor
    if val <= 0.151 then
        ratingLabel.Text = "BLATANT"
    elseif val <= 0.35 then
        ratingLabel.Text = "LEGIT"
    else
        ratingLabel.Text = "SLOW"
    end

    local colorTweenInfo = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

    if not autoBlockEnabled then
        targetColor = Color3.fromRGB(120, 120, 130)
        TweenService:Create(ratingLabel, colorTweenInfo, {TextColor3 = targetColor}):Play()
        TweenService:Create(ratingStroke, colorTweenInfo, {Color = targetColor}):Play()
        
        local gradient = ratingStroke:FindFirstChildOfClass("UIGradient")
        if gradient then 
            TweenService:Create(gradient, colorTweenInfo, {Transparency = NumberSequence.new(1)}):Play()
        end
    else
        if val <= 0.151 then
            targetColor = Color3.fromRGB(219, 14, 51)
        elseif val <= 0.35 then
            targetColor = Color3.fromRGB(46, 204, 113)
        else
            targetColor = Color3.fromRGB(241, 196, 15)
        end
        
        TweenService:Create(ratingLabel, colorTweenInfo, {TextColor3 = targetColor}):Play()
        TweenService:Create(ratingStroke, colorTweenInfo, {Color = targetColor}):Play()
        
        local gradient = ratingStroke:FindFirstChildOfClass("UIGradient")
        if gradient then gradient:Destroy() end
        local _, sweepTween = applySweepingGlow(ratingStroke, targetColor, 3.5, 0.16, 0.5)
        activeRatingTween = sweepTween
    end
end

toggleBtn.MouseButton1Click:Connect(function()
    autoBlockEnabled = not autoBlockEnabled
    if autoBlockEnabled then
        toggleBtn.Text = "ENABLED"
        toggleBtn.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
        TweenService:Create(sliderFill, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            BackgroundColor3 = Color3.fromRGB(52, 152, 219)
        }):Play()
    else
        toggleBtn.Text = "DISABLED"
        toggleBtn.BackgroundColor3 = Color3.fromRGB(231, 76, 60)
        TweenService:Create(sliderFill, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            BackgroundColor3 = Color3.fromRGB(120, 120, 130)
        }):Play()
    end
    updateRatingText(responseDelay)
end)

subToggleBtn.MouseButton1Click:Connect(function()
    autoSubmitEnabled = not autoSubmitEnabled
    if autoSubmitEnabled then
        subToggleBtn.Text = "ON"
        subToggleBtn.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
        TweenService:Create(subSliderFill, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            BackgroundColor3 = Color3.fromRGB(255, 140, 90)
        }):Play()
    else
        subToggleBtn.Text = "OFF"
        subToggleBtn.BackgroundColor3 = Color3.fromRGB(231, 76, 60)
        TweenService:Create(subSliderFill, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            BackgroundColor3 = Color3.fromRGB(120, 120, 130)
        }):Play()
    end
end)

--------------------------------------------------------------------------------
-- SLIDERS LOGIC 
--------------------------------------------------------------------------------
local sliderActive = false
local subSliderActive = false
local sliderTweenInfo = TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

local function updateSlider(input)
    local trackPos = sliderTrack.AbsolutePosition.X
    local trackWidth = sliderTrack.AbsoluteSize.X
    local mouseX = input.Position.X
    local relativeX = math.clamp((mouseX - trackPos) / trackWidth, 0, 1)
    
    local rawVal = relativeX * 0.5
    local steppedVal = math.floor((rawVal / 0.05) + 0.5) * 0.05
    steppedVal = math.clamp(steppedVal, 0, 0.5)
    
    responseDelay = steppedVal
    local alpha = responseDelay / 0.5
    
    TweenService:Create(sliderFill, sliderTweenInfo, {Size = UDim2.new(alpha, 0, 1, 0)}):Play()
    TweenService:Create(sliderKnob, sliderTweenInfo, {Position = UDim2.new(alpha, 0, 0.5, 0)}):Play()
    
    delayLabel.Text = string.format("Delay: %.2fs", responseDelay)
    updateRatingText(responseDelay)
end

local function updateSubSlider(input)
    local trackPos = subSliderTrack.AbsolutePosition.X
    local trackWidth = subSliderTrack.AbsoluteSize.X
    local mouseX = input.Position.X
    local relativeX = math.clamp((mouseX - trackPos) / trackWidth, 0, 1)
    
    local rawVal = relativeX * 0.5 
    local steppedVal = math.floor((rawVal / 0.05) + 0.5) * 0.05
    steppedVal = math.clamp(steppedVal, 0, 0.5)
    
    predictionFactor = steppedVal
    local alpha = predictionFactor / 0.5
    
    TweenService:Create(subSliderFill, sliderTweenInfo, {Size = UDim2.new(alpha, 0, 1, 0)}):Play()
    TweenService:Create(subSliderKnob, sliderTweenInfo, {Position = UDim2.new(alpha, 0, 0.5, 0)}):Play()
    
    if predictionFactor >= 0.34 then
        subLabel.Text = string.format("Prediction: %.2f (⚠️ may overpredict)", predictionFactor)
    elseif predictionFactor >= 0.29 then
        subLabel.Text = string.format("Prediction: %.2f (+++ prediction)", predictionFactor)
    elseif predictionFactor >= 0.24 then
        subLabel.Text = string.format("Prediction: %.2f (++ prediction)", predictionFactor)
    elseif predictionFactor >= 0.19 then
        subLabel.Text = string.format("Prediction: %.2f (+ prediction)", predictionFactor)
    elseif predictionFactor >= 0.14 then
        subLabel.Text = string.format("Prediction: %.2f (Default)", predictionFactor)
    else
        subLabel.Text = string.format("Prediction: %.2f (follows, no prediction)", predictionFactor)
    end
end

updateRatingText(responseDelay)

sliderTrack.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        sliderActive = true
        updateSlider(input)
    end
end)

subSliderTrack.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        subSliderActive = true
        updateSubSlider(input)
    end
end)

UIS.InputChanged:Connect(function(input)
    if (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        if sliderActive then
            updateSlider(input)
        elseif subSliderActive then
            updateSubSlider(input)
        end
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        sliderActive = false
        subSliderActive = false
    end
end)

--------------------------------------------------------------------------------
-- AUTO CLEANUP
--------------------------------------------------------------------------------
G.__abCleanup = function()
    for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
    if screenGui then screenGui:Destroy() end
    print("[stopped previous instance]")
end

--------------------------------------------------------------------------------
-- REMOTE DETECTION (TAKEDOWN BLOCKER)
--------------------------------------------------------------------------------
local function wf(parent, name)
    local obj = parent:FindFirstChild(name)
    while not obj do
        print("[WAIT] " .. parent.Name .. "." .. name .. " (enter a fight)")
        obj = parent:WaitForChild(name, 5)
    end
    return obj
end

local remotes = wf(wf(game:GetService("ReplicatedStorage"), "Framework"), "RemoteEvents")
local RE = wf(remotes, lp.UserId .. "MainFrame")
local pg = wf(lp, "PlayerGui")
local frame = wf(wf(pg, "Transitions"), "Frame")
local val = wf(wf(frame, "Progress"), "Value")

local DIRS = {"Up","Down","Left","Right"}
local holds, arrows = {}, {}
for _, d in ipairs(DIRS) do
    holds[d]  = wf(frame, "Hold"..d)
    arrows[d] = wf(frame, "Arrow"..d)
end

G.__abState = G.__abState or {ourActive = false, ourTime = 0, sending = false}
local S = G.__abState
S.RE = RE

local canHook = type(hookmetamethod) == "function"
    and type(getnamecallmethod) == "function"
    and type(getrawmetatable) == "function"

if canHook and not G.__abHooked then
    local ok, err = pcall(function()
        local old = rawget(getrawmetatable(game), "__namecall")
        if type(old) ~= "function" then error("no original __namecall") end
        local function track(self, ...)
            if getnamecallmethod() == "FireServer" and self == S.RE and not S.sending then
                local a = ...
                if type(a) == "table" then
                    if a.Type == "Transition" then
                        S.ourActive = true
                        S.ourTime = tick()
                    elseif a.Type == "StopTransitioning" then
                        S.ourActive = false
                    end
                end
            end
        end
        local wrap = function(self, ...)
            pcall(track, self, ...)
            return old(self, ...)
        end
        if type(newcclosure) == "function" then wrap = newcclosure(wrap) end
        local ret = hookmetamethod(game, "__namecall", wrap)
        if type(ret) == "function" then old = ret end
        G.__abHooked = true
    end)
    if not ok then warn("[WARN] hook failed: " .. tostring(err)) end
end

--------------------------------------------------------------------------------
-- AUTO BLOCK LOGIC (TAKEDOWN)
--------------------------------------------------------------------------------
local KEYS = {Enum.KeyCode.W, Enum.KeyCode.A, Enum.KeyCode.S, Enum.KeyCode.D,
              Enum.KeyCode.Up, Enum.KeyCode.Down, Enum.KeyCode.Left, Enum.KeyCode.Right}

local function anyKeyDown()
    for _, k in ipairs(KEYS) do
        if UIS:IsKeyDown(k) then return true end
    end
    return false
end

local blockedDir = nil
local lastFire = 0
local roundStart = 0
local noDirWarned = false
local prevVal = 0
local arrowT = {Up = 0, Down = 0, Left = 0, Right = 0}

local function gradMax(inst)
    local g = inst:FindFirstChildOfClass("UIGradient")
    if not g then return 0 end
    local m = 0
    for _, kp in ipairs(g.Transparency.Keypoints) do
        if kp.Value > m then m = kp.Value end
    end
    return m
end

local function dimState()
    local undimmed, parts = {}, {}
    for _, d in ipairs(DIRS) do
        local v = math.max(gradMax(holds[d]), gradMax(arrows[d]))
        parts[#parts+1] = string.format("%s=%.2f", d, v)
        if v < 0.001 then undimmed[#undimmed+1] = d end
    end
    return undimmed, table.concat(parts, " ")
end

local function currentDir()
    local undimmed, desc = dimState()
    if #undimmed == 1 then return undimmed[1], "dim", desc end
    local hits = {}
    for _, d in ipairs(DIRS) do
        if arrowT[d] >= tick() - 0.1 then hits[#hits+1] = d end
    end
    if #hits == 1 then return hits[1], "arrow", desc end
    return nil, nil, desc
end

local function isOurs()
    if S.ourActive or (tick() - S.ourTime) < 0.25 then return true end
    if not G.__abHooked and anyKeyDown() then return true end
    return false
end

local function fire(dir)
    S.sending = true
    RE:FireServer({Type = "Transition", Submission = false, Direction = dir})
    RE:FireServer({Type = "StopTransitioning"})
    S.sending = false
    lastFire = tick()
end

local function evaluate(src)
    if not autoBlockEnabled then return end
    if val.Value <= 0 or isOurs() then return end
    if tick() - lastFire < ECHO_GUARD then return end
    local dir, how, desc = currentDir()
    if not dir or dir == blockedDir then return end
    blockedDir = dir
    
    task.delay(responseDelay, function()
        if autoBlockEnabled and val.Value > 0 then
            fire(dir)
        end
    end)
end

--------------------------------------------------------------------------------
-- SUBMISSION AUTO-TRACKER LOGIC
--------------------------------------------------------------------------------
local updateSubRemote = ReplicatedStorage:WaitForChild("Framework"):WaitForChild("RemoteEvents"):FindFirstChild("UpdateSubmissionPosition")
if not updateSubRemote then
    pcall(function()
        local Framework = require(ReplicatedStorage:WaitForChild("Framework"))
        updateSubRemote = Framework:GetRemoteEvent("UpdateSubmissionPosition")
    end)
end

local currentSubDirection = "idle"
local wasInSubGUI = false

local function updateSubMovement(barInstance, direction)
    if not updateSubRemote then return end
    if direction == "left" and currentSubDirection ~= "left" then
        updateSubRemote:FireServer(barInstance, true)
        currentSubDirection = "left"
    elseif direction == "right" and currentSubDirection ~= "right" then
        updateSubRemote:FireServer(barInstance, false)
        currentSubDirection = "right"
    elseif direction == "idle" and currentSubDirection ~= "idle" then
        updateSubRemote:FireServer(barInstance, nil)
        currentSubDirection = "idle"
    end
end

--------------------------------------------------------------------------------
-- CONNECTIONS
--------------------------------------------------------------------------------
conns[#conns+1] = val:GetPropertyChangedSignal("Value"):Connect(function()
    local v = val.Value
    if v > 0 and prevVal == 0 then
        roundStart = tick()
        blockedDir = nil
        noDirWarned = false
        evaluate("val")
    elseif v == 0 and prevVal > 0 then
        blockedDir = nil
        S.ourActive = false
    end
    prevVal = v
end)

for _, d in ipairs(DIRS) do
    for _, inst in ipairs({holds[d], arrows[d]}) do
        local g = inst:FindFirstChildOfClass("UIGradient")
        if g then
            conns[#conns+1] = g:GetPropertyChangedSignal("Transparency"):Connect(function()
                evaluate("dim")
            end)
        end
    end
    conns[#conns+1] = arrows[d].Changed:Connect(function()
        if tick() - lastFire > 0.3 then arrowT[d] = tick() end
        evaluate("arrow")
    end)
end

conns[#conns+1] = RS.Heartbeat:Connect(function()
    evaluate("hb")
    if val.Value > 0 and not blockedDir and not noDirWarned and not isOurs() and tick() - roundStart > 0.25 then
        noDirWarned = true
    end

    if not autoSubmitEnabled then return end
    local screenGuiCheck = lp:FindFirstChild("PlayerGui") and lp.PlayerGui:FindFirstChild("ScreenGui")
    
    if not screenGuiCheck or not screenGuiCheck:FindFirstChild("Line") then
        if wasInSubGUI then
            currentSubDirection = "idle"
            wasInSubGUI = false
        end
        lastEnemyCenter = nil
        return
    end

    if not wasInSubGUI then
        wasInSubGUI = true
        currentSubDirection = "idle"
        lastTime = tick()
    end

    local lineContainer = screenGuiCheck.Line
    local myColor = screenGuiCheck:GetAttribute("Color")
    if not myColor then return end

    local myBar = lineContainer:FindFirstChild(myColor)
    local enemyBar = myColor == "Red" and lineContainer:FindFirstChild("Blue") or lineContainer:FindFirstChild("Red")

    if myBar and enemyBar then
        local currentTime = tick()
        local dt = currentTime - lastTime
        lastTime = currentTime

        local myCenter = myBar.AbsolutePosition.X + (myBar.AbsoluteSize.X / 2)
        local enemyCenter = enemyBar.AbsolutePosition.X + (enemyBar.AbsoluteSize.X / 2)

        local predictedEnemyCenter = enemyCenter
        if lastEnemyCenter and dt > 0 then
            local velocity = (enemyCenter - lastEnemyCenter) / dt
            predictedEnemyCenter = enemyCenter + (velocity * predictionFactor)
        end
        lastEnemyCenter = enemyCenter

        local containerMin = lineContainer.AbsolutePosition.X + (myBar.AbsoluteSize.X / 2)
        local containerMax = (lineContainer.AbsolutePosition.X + lineContainer.AbsoluteSize.X) - (myBar.AbsoluteSize.X / 2)
        predictedEnemyCenter = math.clamp(predictedEnemyCenter, containerMin, containerMax)

        if myCenter < (predictedEnemyCenter - subTolerance) then
            updateSubMovement(myBar, "right")
        elseif myCenter > (predictedEnemyCenter + subTolerance) then
            updateSubMovement(myBar, "left")
        else
            updateSubMovement(myBar, "idle")
        end
    else
        currentSubDirection = "idle"
        lastEnemyCenter = nil
    end
end)

print("Thanks for purchasing Auto Block! - Version 4.8")
