--------------------------------------------------------------------------------
-- SWEEPING GLOW
--------------------------------------------------------------------------------
local function applySweepingGlow(stroke, color, duration, bandWidth, baseTransparency)
    duration = duration or 3.5
    bandWidth = bandWidth or 0.12
    baseTransparency = baseTransparency or 0.55

    local gradient = stroke:FindFirstChildOfClass("UIGradient")
    if not gradient then
        gradient = Instance.new("UIGradient")
        gradient.Parent = stroke
    end

    gradient.Color = ColorSequence.new(color)
    gradient.Rotation = 0

    local half = bandWidth / 2
    gradient.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 1),
        NumberSequenceKeypoint.new(math.clamp(0.5 - half, 0, 1), 1),
        NumberSequenceKeypoint.new(0.5, 0.05),
        NumberSequenceKeypoint.new(math.clamp(0.5 + half, 0, 1), 1),
        NumberSequenceKeypoint.new(1, 1),
    })

    gradient.Offset = Vector2.new(-1, 0)

    local sweepInfo = TweenInfo.new(duration, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, false)
    local sweepTween = TweenService:Create(gradient, sweepInfo, {Offset = Vector2.new(1, 0)})
    sweepTween:Play()

    return gradient, sweepTween
end

